[Unit]
Description=sudo-telegram approval daemon
Documentation=file:///home/sergioc/.bots/sudo-telegram/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/sudo-telegram-daemon
Restart=on-failure
RestartSec=3
User=root
Group=root

# Runtime dir is managed by systemd; log dir is created by INSTALL.sh
# (we deliberately avoid LogsDirectory= because the child process lacks
# CAP_FOWNER to chmod the dir on subsequent restarts → status=240/LOGS_DIRECTORY).
RuntimeDirectory=sudo-telegram
RuntimeDirectoryMode=0755

# Hardening — daemon needs to read /etc/sudo-telegram and write /run + /var/log
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/etc/sudo-telegram
ReadWritePaths=/run/sudo-telegram /var/log/sudo-telegram
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
# CAP_SYS_PTRACE is needed to read /proc/<sudo_pid>/cmdline — sudo is suid
# root and sets dumpable=0, which gates /proc access via ptrace_may_access()
# even when both processes run as root.
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_READ_SEARCH CAP_SYS_PTRACE

[Install]
WantedBy=multi-user.target
